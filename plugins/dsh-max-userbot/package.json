{
  "name": "@mikhail/dsh-max-userbot",
  "version": "0.1.0",
  "description": "MAX userbot front for DeepSeek Harness (ctx.agents + credentials)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs');const p='lib/vendor/max-account-api/dist';if(!fs.existsSync(p)){console.warn('[dsh-max-userbot] Run: cd lib/vendor/max-account-api && npm install && npm run build')}\"",
    "test": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=lib/**/*.js --test-coverage-exclude=lib/vendor/** --test-coverage-exclude=lib/index.js --test-coverage-exclude=lib/transport/** test/*.test.js"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.0.0",
    "max-account-api": "file:./lib/vendor/max-account-api"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
