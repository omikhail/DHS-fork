{
  "name": "max-account-api",
  "version": "0.1.1-spyder.1",
  "description": "Unofficial Node.js client for personal MAX (web.max.ru) accounts. Reverse-engineered WebSocket + mobile binary protocol. Phone- or QR-login, send/receive messages, manage chats — like node-telegram-bot-api but for your own MAX account.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "example:echo": "tsx examples/echo-bot.ts",
    "example:phone": "tsx examples/phone-bot.ts"
  },
  "keywords": [
    "max",
    "max.ru",
    "oneme",
    "messenger",
    "websocket",
    "client",
    "userbot",
    "account-api",
    "tamtam",
    "vk"
  ],
  "author": "maxsos1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxsos1/max-account-api.git"
  },
  "bugs": {
    "url": "https://github.com/maxsos1/max-account-api/issues"
  },
  "homepage": "https://github.com/maxsos1/max-account-api#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "lz4js": "^0.2.0",
    "msgpackr": "^2.0.1",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18.17"
  }
}
